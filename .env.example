# Application (Coolify: public HTTPS domain, without :3000)
PORT=3000
BASE_URL=http://localhost:3000

# Redis for running Node directly. Docker Compose uses its internal Redis service.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Docker Compose fixes this to uploads and mounts a persistent volume there.
UPLOAD_DIR=uploads

# External API
EXTERNAL_API_BASE_URL=https://apisatistakip.hebilogluahsap.com
EXTERNAL_API_QUOTATION_UPDATE_ENDPOINT=/api/Quotations/:id/pdf-url
